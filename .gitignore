# Generated output files (created by build scripts or CI pipeline)
output/

# Local build directory
build/

# Preview images in root (temporary)
preview_*.png

# Temporary files
tmpclaude-*
*.tmp

# STL and PNG are generated - never commit
*.stl
*.png

# Exception: Keep source images if any exist in assets/
!assets/*.png

# Local Acer CAD exports and slicer run reports; retain generators and notes.
/concept-*/*.step
/concept-*/*.3mf
/concept-*/*.json
/concept-*/bambu-cli-*.txt
/result.json
__pycache__/

# Generated slicer toolpaths and local build diagnostics
/concept-*/*.gcode
/concept-*/*-log.txt
